# Frontend env (Vercel > Settings > Environment Variables, plus local `frontend/.env`)
# Cloud sync (optional — without these the app is local-only on Vercel):
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Demo mode (GitHub Pages only, leave unset on Vercel):
# VITE_DEMO=0
# Exercise media. Optional: if unset, the app loads images/GIFs from this same pinned
# jsdelivr mirror of the dataset (nothing bundles ~140 MB of media). Set these only to serve
# your own copy — e.g. VITE_IMG_BASE=img/ with a local media server at MEDIA_TARGET.
VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/images/
VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/videos/
