# Exercise media — large binaries, served separately, never committed
media/img/
media/gif/

# Runtime data (local dev only)
data/

# Local config
.env

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store

# Local AI-assistant tooling — contributor's own setup, not part of the app
.claude/
.codex/
CLAUDE.md
graphify-out/
.opencode/
# Agent session transcripts: useful while the session runs, noise in every later `git status`
session-*.md

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Downloads from the app itself — your own training data, not project files.
# Every export the app writes is named opengym-* (plan, routine, exercise, day, AI export),
# and they land wherever the browser saves them; this covers a save straight into the repo root.
/opengym-*.json
/opengym-*.csv
